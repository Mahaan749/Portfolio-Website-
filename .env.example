# Required — Resend API key for the contact form
RESEND_API_KEY=

# Optional — WebSocket server URL for realtime features (live cursors, chat, presence)
# Leave empty to disable realtime features entirely
NEXT_PUBLIC_WS_URL=

# Optional — Umami analytics. Nothing loads unless UMAMI_SITE_ID is set.
# UMAMI_DOMAIN overrides the default script URL — set it if you self-host.
UMAMI_DOMAIN=
UMAMI_SITE_ID=

# Optional — Umami website id that /api/collect records deploy hostnames into.
# Unset = the endpoint only writes to the runtime log.
UMAMI_DEPLOY_SITE_ID=

# Optional — old domain you moved away from (e.g. example.site).
# When set, shows a one-time dismissible "we moved" notice. Leave empty.
NEXT_PUBLIC_LEGACY_HOST=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
ADMIN_PASSWORD=choose-a-strong-admin-password
ADMIN_SESSION_SECRET=use-a-long-random-server-secret
